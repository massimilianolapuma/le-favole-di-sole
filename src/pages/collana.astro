---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import Shelf from '../components/Shelf.astro';
import { books, series, site } from '../config/site';
import { absoluteUrl, link } from '../lib/paths';

const available = series.filter((s) => s.status === 'disponibile').length;

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BookSeries',
  name: site.seriesName,
  inLanguage: 'it',
  author: { '@type': 'Person', name: site.author.name },
  url: absoluteUrl('/collana'),
  hasPart: books.map((b) => ({ '@type': 'Book', name: b.title, position: b.volume, url: absoluteUrl(`/libri/${b.slug}`) })),
};
---

<BaseLayout
  title="La collana Le Emozioni di Sole — dieci favole sulle emozioni"
  description="Le Emozioni di Sole: una collana di dieci favole e fumetti illustrati per bambini dai 3 ai 9 anni. Ogni volume accompagna bambini e adulti nell'ascolto di un'emozione."
  jsonLd={[collectionJsonLd]}
  mobileCta={{ label: 'Ricevi per prima le prossime emozioni', href: '/newsletter#modulo', track: 'cta_lead_magnet' }}
>
  <section class="intro">
    <div class="wrap intro-grid">
      <div class="intro-copy">
        <h1>{site.seriesName}</h1>
        <p class="lede">
          Una collana di dieci favole e fumetti illustrati. Ogni volume accompagna bambini e adulti nell'ascolto di
          un'emozione, con una storia da leggere insieme e piccole attività per continuare a parlarne.
        </p>
        <p class="muted count">Oggi sono disponibili {available} volumi su {series.length}: scegli un dorso per scoprirli.</p>
      </div>
      <div class="series-shelf">
        <Shelf />
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="disponibili-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="disponibili-title">Disponibili ora</h2>
        <p>Si possono leggere in qualsiasi ordine. Ogni volume è una storia completa.</p>
      </div>
      <div class="books">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="come-title">
    <div class="wrap how">
      <div class="measure">
        <h2 id="come-title">Com'è fatto ogni volume</h2>
        <p class="muted">
          Ogni libro ha la stessa struttura, così bambini e adulti sanno cosa aspettarsi: prima il fumetto, poi la
          favola completa, quindi un disegno da colorare, alcune attività sull'emozione del volume e una mini guida
          per chi legge.
        </p>
      </div>
      <div class="next" data-hides-mobile-bar>
        <h2 class="next-title">Le prossime emozioni arrivano per email</h2>
        <p class="muted">
          Ti scriviamo quando esce un nuovo volume. Iscrivendoti ricevi subito, gratis,
          «{site.leadMagnet.title}».
        </p>
        <a class="btn btn--primary" href={link('/newsletter#modulo')} data-track="cta_lead_magnet" data-track-label="collana">
          Ricevi per prima le prossime emozioni
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }

  .intro-copy .lede {
    margin-bottom: 1.25rem;
  }

  .count {
    margin: 0;
  }

  @media (max-width: 52rem) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .intro-copy {
      max-width: var(--measure);
    }
  }

  /* Su mobile il conteggio è già detto dallo scaffale: lo togliamo per liberare la prima schermata */
  @media (max-width: 40rem) {
    .count {
      display: none;
    }
  }

  .books {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .how {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .next {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-blob);
    background-color: var(--sole);
    background-image: var(--paper-grain);
    border: 2px solid var(--ink);
  }

  .next .muted {
    color: var(--ink);
  }

  .next-title {
    font-size: var(--step-2);
  }

  .next .btn--primary {
    background: var(--paper);
  }

  @media (max-width: 52rem) {
    .books,
    .how {
      grid-template-columns: 1fr;
    }
  }
</style>
