---
import { emotionCards } from '../data/content';
import { site } from '../config/site';

const preview = emotionCards.slice(0, 3);
---

<figure class="cards">
  <ul class="deck">
    {preview.map((card, i) => (
      <li class="card" style={`--tone: var(--${card.tone}); --i: ${i}`}>
        <span class="card-meta">Carta {i + 1} di {emotionCards.length} · {card.emotion}</span>
        <span class="card-q">{card.question}</span>
        <span class="card-a">{card.activity}</span>
      </li>
    ))}
  </ul>
  <figcaption class="small muted">
    Anteprima di tre carte su dieci. Il {site.leadMagnet.format.toLowerCase()} contiene tutte le domande e le attività.
  </figcaption>
</figure>

<style>
  .cards {
    margin: 0;
  }

  .deck {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: min(100%, 26rem);
    height: 22rem;
  }

  .card {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 14.5rem;
    height: 19.5rem;
    padding: 1.3rem 1.2rem;
    background-color: var(--tone);
    background-image: var(--paper-grain);
    border: 2px solid var(--ink);
    border-radius: 1.1rem;
    box-shadow: 0 14px 24px -18px rgb(46 53 80 / 0.7);
  }

  .card:nth-child(1) {
    transform: translateX(-95%) translateY(1.6rem) rotate(-8deg);
  }

  .card:nth-child(2) {
    transform: translateX(-50%) rotate(1deg);
    z-index: 2;
  }

  .card:nth-child(3) {
    transform: translateX(-5%) translateY(1.4rem) rotate(7deg);
  }

  .card-meta {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .card-q {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .card-a {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1.5px dashed rgb(46 53 80 / 0.4);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  figcaption {
    text-align: center;
    margin-top: 1rem;
  }

  @media (max-width: 30rem) {
    .deck {
      height: 19rem;
    }
    .card {
      width: 11.6rem;
      height: 16.5rem;
      padding: 1rem 0.9rem;
      gap: 0.6rem;
    }
    .card-q {
      font-size: 1.08rem;
    }
    .card-a {
      font-size: 0.85rem;
    }
    .card:nth-child(1) {
      transform: translateX(-88%) translateY(1.4rem) rotate(-7deg);
    }
    .card:nth-child(3) {
      transform: translateX(-12%) translateY(1.2rem) rotate(6deg);
    }
  }
</style>
